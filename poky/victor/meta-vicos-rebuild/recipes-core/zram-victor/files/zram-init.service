[Unit]
Description=Initialize zram Swap
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c '\
  modprobe zram && \
  zramctl zram0 --algorithm lz4 --size 256M && \
  mkswap /dev/zram0 && \
  swapon --priority 100 /dev/zram0'
ExecStop=/bin/sh -c '\
  swapoff /dev/zram0 && \
  zramctl --reset /dev/zram0'

[Install]
WantedBy=multi-user.target
